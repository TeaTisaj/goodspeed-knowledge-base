# ---------------------------------------------------------------------------
# Copy to .env  ->  cp .env.example .env
# `pnpm bootstrap` does this for you and fills in the local Supabase values.
#
# Every variable is validated by a Zod schema at boot (apps/api/src/config).
# A missing or malformed value stops the process with an actionable message
# rather than surfacing as a 500 on the first request that needs it.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3001
# Origins allowed to call the API (comma separated). The browser talks to
# NestJS directly. localhost and 127.0.0.1 are different origins to a browser,
# so both are listed -- a reviewer may open either.
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# --- Supabase --------------------------------------------------------------
# These are the default keys printed by `supabase start`. They are identical on
# every local install and are NOT secrets. Replace for any hosted deployment.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
# Server-side only. Never expose to the browser. Held by the ingestion worker.
SUPABASE_SECRET_KEY=sb_secret_N7UND0UgjKTVK-Uodkm0Hg_xSvEMPvz

# Direct Postgres connection for the pg-boss job queue.
# MUST be a direct or session-mode DSN: pg-boss uses LISTEN/NOTIFY, which a
# transaction-mode pooler (Supabase port 6543) does not support — jobs would
# silently never be picked up.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# inline     - the API process consumes jobs (default; one command locally)
# standalone - the API enqueues only; run `node dist/main.worker.js` alongside it
#              to consume. This is how ingestion moves off the API boxes.
# off        - nothing consumes (useful when debugging the API alone)
WORKER_MODE=inline

# --- AI providers ----------------------------------------------------------
# Chat and embeddings are configured independently, because real deployments
# mix them (e.g. chat on Groq, embeddings on OpenAI — Groq has no embeddings
# endpoint, and the config refuses that combination at boot).
#
# Any provider speaking the OpenAI /v1/chat/completions spec works by setting
# the base URL and key. See README "Swapping AI providers".
#
#   fake       no credentials, deterministic, offline. The default, so the app
#              runs with zero setup. Embeddings are a hashing vectorizer, so
#              retrieval still behaves sensibly.
#   openai     https://api.openai.com/v1
#   groq       https://api.groq.com/openai/v1          (chat only)
#   gemini     https://generativelanguage.googleapis.com/v1beta/openai/
#   mistral    https://api.mistral.ai/v1               (embeddings are 1024d)
#   together   https://api.together.xyz/v1
#   openrouter https://openrouter.ai/api/v1
#   ollama     http://localhost:11434/v1               (no key needed)
#
# Chat and embeddings are not equally free to change. Swapping the CHAT
# provider is a restart. Swapping the EMBEDDING provider invalidates every
# stored vector -- vectors from different models are not comparable -- so it
# needs a re-ingest, and a migration too if the dimension differs from 1536.
# gemini is the one non-OpenAI embedder here that drops in without a migration,
# because its vectors truncate cleanly to 1536.

# Models default to the provider's preset (e.g. gpt-5.6 and text-embedding-3-small
# for openai). Required for a provider without a preset.
AI_CHAT_PROVIDER=fake
# AI_CHAT_MODEL=gpt-5.6
# AI_CHAT_BASE_URL=https://api.openai.com/v1
# AI_CHAT_API_KEY=sk-...

AI_EMBEDDING_PROVIDER=fake
# AI_EMBEDDING_MODEL=text-embedding-3-small
# AI_EMBEDDING_BASE_URL=https://api.openai.com/v1
# AI_EMBEDDING_API_KEY=sk-...

# Must match the vector(N) column dimension in the migrations. Changing this
# requires re-ingesting every document. Capped at 2000: pgvector's HNSW index
# supports at most 2000 dimensions for the `vector` type.
AI_EMBEDDING_DIMENSIONS=1536

AI_REQUEST_TIMEOUT_MS=30000
AI_MAX_RETRIES=2
# Ceiling on one answer's completion tokens: the per-request cost cap. Unset,
# providers default to the model's own maximum (OpenRouter reserves 65k per
# request). Keep it generous for reasoning models (every Groq model is one):
# they spend this budget on hidden reasoning before the first visible token,
# and too low a value returns an empty answer.
AI_ANSWER_MAX_TOKENS=2048

# --- Retrieval tuning ------------------------------------------------------
# Candidates pulled from each retrieval arm before fusion. Higher costs one
# index scan and gives the fusion more to work with.
RETRIEVAL_CANDIDATES=12
# Sources actually placed in the prompt after fusion (and reranking, if on).
RETRIEVAL_TOP_K=6
# Out-of-scope guard: a chunk below this cosine similarity (and not matched by
# keyword) is not relevant, and when nothing is relevant the API refuses
# without calling the chat model. Specific to the embedding model, so leave it
# unset to use the value measured for yours (text-embedding-3-small: 0.15) --
# `pnpm eval --embed=<provider>:<model>` prints the calibration for any other.
# 0 disables it. See eval/README.md.
# RETRIEVAL_MIN_SIMILARITY=0.15
# Hypothetical-document expansion: one extra model call per question that
# embeds a plausible answer alongside the question. Helps paraphrased
# questions (paraphrase hit@6 50% -> 75% in eval/retrieval-experiments.mjs)
# at the cost of a call and its latency. Never overrides the relevance floor.
RETRIEVAL_HYDE=false
# LLM reranking. Off by default: it costs a model call per question, and the
# eval harness has not yet shown it pays for itself. See eval/README.md.
AI_RERANK_ENABLED=false
# Ceiling on the tokens of retrieved context placed in the prompt. Must stay
# inside the chat model's own context window.
MAX_CONTEXT_TOKENS=8000

# --- Web -------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH

# --- Live provider tests (optional) ----------------------------------------
# `pnpm test:live` runs the provider contract against real endpoints. Keys are
# read from .env.local, .env.live or .env -- whichever you prefer; all three are
# gitignored. Only LIVE_-prefixed names are imported, and that prefix is what
# keeps the concerns apart: the app reads AI_CHAT_API_KEY, so a LIVE_ key can
# never silently point the running app at a metered provider, wherever it sits.
#
# Free tiers rate-limit hard (Gemini allows 20 requests/day on its default
# model; Mistral throttles within a couple of calls). The suite reports a 429 as
# "skipped, not exercised" rather than as a pass or a failure.
#
# Opt in per provider by dropping its key in .env.local. A provider with a key
# is tested; one without is skipped by name and the run says so.
#
#   LIVE_OPENAI_API_KEY=sk-...
#   LIVE_GROQ_API_KEY=gsk_...            # free tier, chat only
#   LIVE_OPENROUTER_API_KEY=sk-or-...    # free tier
#   LIVE_TOGETHER_API_KEY=...
#   LIVE_GEMINI_API_KEY=...
#   LIVE_MISTRAL_API_KEY=...
#
# Optional per-provider overrides, when the preset default is not what you want
# to spend on:
#
#   LIVE_OPENAI_CHAT_MODEL=gpt-5.6
#   LIVE_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
#   LIVE_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
#
# Ollama needs no key -- it is included whenever it answers on its port:
#   brew install ollama && ollama serve
#   ollama pull llama3.2 && ollama pull nomic-embed-text
#
# LIVE_SKIP_REACHABILITY=1 drops the keyless probes for a fully offline run.
