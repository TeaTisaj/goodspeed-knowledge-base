{
  "name": "@kb/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:watch": "vitest",
    "test:integration": "vitest run --project integration",
    "test:all": "vitest run",
    "start:worker": "node dist/main.worker.js",
    "dev:worker": "WORKER_MODE=standalone nest start --watch --entryFile main.worker"
  },
  "dependencies": {
    "@nestjs/common": "12.0.4",
    "@nestjs/core": "12.0.4",
    "@nestjs/platform-express": "12.0.4",
    "@nestjs/throttler": "6.7.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5",
    "@supabase/supabase-js": "2.116.0",
    "@kb/contracts": "workspace:*",
    "@kb/ai": "workspace:*",
    "@kb/rag": "workspace:*",
    "jose": "6.1.0",
    "pg-boss": "12.33.2",
    "unpdf": "1.8.1"
  },
  "devDependencies": {
    "@kb/eslint-config": "workspace:*",
    "@kb/tsconfig": "workspace:*",
    "@nestjs/cli": "12.0.3",
    "@nestjs/testing": "12.0.4",
    "@types/express": "5.0.6",
    "@types/node": "24.13.6",
    "eslint": "10.11.0",
    "typescript": "6.0.3",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.1",
    "@swc/core": "1.16.2"
  },
  "type": "module"
}
