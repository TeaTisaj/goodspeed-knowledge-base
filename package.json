{
  "name": "goodspeed-knowledge-base",
  "private": true,
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:live": "pnpm --filter @kb/ai test:live",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:status": "supabase status",
    "db:seed": "node scripts/seed.mjs",
    "reembed": "node scripts/reembed.mjs",
    "test:e2e": "playwright test",
    "bootstrap": "node scripts/setup.mjs",
    "test:integration": "pnpm --filter @kb/api test:integration",
    "eval": "node eval/run.mjs",
    "eval:generation": "node eval/generation.mjs"
  },
  "devDependencies": {
    "prettier": "3.9.8",
    "supabase": "2.117.0",
    "turbo": "2.11.2",
    "typescript": "6.0.3",
    "@supabase/supabase-js": "2.116.0",
    "@playwright/test": "1.63.0",
    "@kb/ai": "workspace:*",
    "@kb/rag": "workspace:*",
    "@kb/contracts": "workspace:*"
  }
}
